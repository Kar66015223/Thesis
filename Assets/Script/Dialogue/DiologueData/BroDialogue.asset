  m_Script: {fileID: 11500000, guid: d1c940f67efb94947984c2d0dc22a529, type: 3}
  m_Name: BroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  conversationLines: []
  playerName: Arthur
  playerDialogueText: I'm going outside for a moment.
  npcName: Felix
  dialogueText: Where are you going? It's dangerous out there!
  choices:
  - choiceText: Promise
    responseText: I'll be right back. Stay here for now, and I promise I won't leave
      you behind.
    endDialogue: 0
    nextDialogue: {fileID: 0}
  - choiceText: Reasoning
    responseText: I have to find the Morse code that reveals the escape route. We
      can't escape if we don't know the way out.
    endDialogue: 0
    nextDialogue: {fileID: 0}
  - choiceText: Firm
    responseText: Don't worry about me. Take good care of yourself, and just wait
      for me to come back.
    endDialogue: 0
    nextDialogue: {fileID: 0}
