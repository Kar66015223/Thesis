    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PBRMaps",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 n = NormalTS;\nif (dot(n, n) < 1e-5) n = float3(0, 0, 1);\nn.xy *= NormalStrength;\nNormalTS_Out = normalize(n);\nAlbedo_Out = BaseTex.rgb * TintColor.rgb;\nMetallic_Out = saturate(MetallicMap * MetallicScale);\nSmoothness_Out = saturate(1.0 - RoughnessMap * RoughnessScale);\nAO_Out = lerp(1.0, saturate(AOMap), saturate(AOStrength));\n"
}

